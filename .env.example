# Google Apps Script Web App URL (only needed when Supabase env vars are not set)
NEXT_PUBLIC_SHEETS_API_URL=https://script.google.com/macros/s/AKfycbxOEKjwP5UXWUJLcsnqNZGWWUOOKTAF9XP5Ldx2Rx4ymHrIO0RoEQldrpnFqcGQH7ao/exec

# Supabase — when both are set, the app uses Supabase instead of Google Sheets
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set to "true" only to use sample data instead of the live API
NEXT_PUBLIC_USE_MOCK_DATA=false
